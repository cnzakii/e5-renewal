E5_PUBLIC_URL=http://localhost:8080
# Optional subpath: https://e5.example.com/tools/e5
# Trust only the proxy addresses seen by the application; empty for direct access.
# E5_TRUSTED_PROXIES=127.0.0.1,::1
E5_LOG_LEVEL=INFO
E5_LOG_FORMAT=text
# Optional additional rotating file; paths inside containers must be writable.
# E5_LOG_FILE=/data/e5-renewal.log
